{
  "name": "@agentmailer/agentmailer",
  "version": "0.3.2",
  "description": "Email inboxes and persistent identities for AI agents, with human-approved email and agent-to-agent communication through MCP.",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aadi-labs/agentmailer-plugins.git"
  },
  "homepage": "https://agentmailer.ai/docs",
  "bugs": {
    "url": "https://github.com/aadi-labs/agentmailer-plugins/issues"
  },
  "files": [
    "skills",
    "plugin.yaml",
    "__init__.py",
    "plugin.json",
    "mcp.json",
    "openclaw.plugin.json",
    "openclaw",
    ".mcp.json",
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    "compat",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "skills:build": "python3 scripts/skills.py build",
    "skills:check": "python3 scripts/skills.py check",
    "skills:test": "python3 -m unittest tests/test_skills_tooling.py",
    "validate": "pnpm skills:check && pnpm skills:test && python3 scripts/validate.py",
    "check": "pnpm validate && pnpm sdk:check",
    "sdk:check": "fern check && node scripts/check-client-surface.mjs",
    "sdk:drift:check": "pnpm sdk:sync:check",
    "examples:check": "pnpm --filter '@agentmailer/example-*' check",
    "examples:generate": "node scripts/generate-examples.mjs",
    "sdk:sync": "node scripts/sync-openapi.mjs",
    "sdk:sync:check": "node scripts/sync-openapi.mjs --check",
    "sdk:postprocess": "node scripts/postprocess-sdks.mjs && node scripts/clean-generated-dependencies.mjs && sh scripts/tidy-go.sh",
    "sdk:generate": "pnpm sdk:generate:local",
    "sdk:generate:local": "pnpm sdk:sync && sh scripts/generate-local.sh all-sdks && pnpm sdk:postprocess && pnpm install --frozen-lockfile",
    "cli:generate": "pnpm cli:generate:local",
    "cli:generate:local": "pnpm sdk:sync && sh scripts/generate-local.sh cli && node scripts/postprocess-cli.mjs",
    "clients:generate": "pnpm clients:generate:local",
    "clients:generate:local": "pnpm sdk:sync && sh scripts/generate-local.sh all && pnpm sdk:postprocess && node scripts/postprocess-cli.mjs && pnpm install --frozen-lockfile",
    "test:typescript": "pnpm --filter @agentmailer/sdk test:unit -- --run",
    "test:go": "sh scripts/test-go.sh",
    "test:rust": "sh scripts/test-rust.sh",
    "test:swift": "swift test --package-path sdk/swift"
  },
  "keywords": [
    "pi-package",
    "agentmailer",
    "agent-skills",
    "email",
    "email-inbox",
    "agent-email",
    "agent-inbox",
    "ai-agents",
    "agent-to-agent-communication",
    "agent-communication",
    "mcp",
    "a2a",
    "agent-identity",
    "webhooks",
    "realtime-events",
    "email-security",
    "productivity",
    "communication",
    "development-tools"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/aadi-labs/agentmailer-plugins/main/plugins/agentmailer/assets/agentmailer-icon-512.png"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./openclaw/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "devDependencies": {
    "fern-api": "5.108.0"
  }
}
